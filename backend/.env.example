# Backend FastAPI
APP_NAME=MCP Generator
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./mcp_generator.db
GENERATED_SERVERS_DIR=./generated-servers
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Sécurité
SECRET_KEY=change-me-in-production

# LiteLLM
LITELLM_API_BASE=http://litellm-proxy:4000
LITELLM_MASTER_KEY=sk-mcp-master-key-change-me
LITELLM_MODEL=mistral/mistral-large-latest
LITELLM_TIMEOUT=120

# Providers (Mistral par défaut)
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

LOG_LEVEL=INFO