# ============================================================
# Variables d'environnement — copier vers `.env` avant usage
# cp .env.example .env
# ============================================================

# --- Backend FastAPI ---
APP_NAME=MCP Generator
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./mcp_generator.db
GENERATED_SERVERS_DIR=./generated-servers
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# --- Sécurité ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LiteLLM ---
LITELLM_API_BASE=http://litellm-proxy:4000
LITELLM_MASTER_KEY=sk-mcp-master-key-change-me
LITELLM_MODEL=mistral/mistral-large-latest
LITELLM_TIMEOUT=120

# --- LLM (fallback direct, sans proxy LiteLLM) ---
# L'architecture supporte plusieurs providers via LiteLLM.
# Provider par défaut : Mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Healthcheck / logs ---
LOG_LEVEL=INFO